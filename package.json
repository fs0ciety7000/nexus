{
  "name": "nexus-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc && vite build && tauri build",
    "typecheck": "tsc --noEmit",
